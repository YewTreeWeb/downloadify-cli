{
  "name": "downloadify-cli",
  "version": "1.0.0",
  "description": "A cli to download videos from the web",
  "author": "Mathew Teague",
  "bin": {
    "downloadify": "./bin/run",
    "dwnify": "./bin/run"
  },
  "homepage": "https://github.com/YewTreeWeb/downloadify-cli",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "YewTreeWeb/downloadify-cli",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@oclif/core": "^2",
    "@oclif/plugin-help": "^5",
    "@oclif/plugin-plugins": "^3.4.0",
    "dayjs": "^1.11.9",
    "node-notifier": "^10.0.1",
    "picocolors": "^1.0.0",
    "puppeteer": "^21.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@oclif/test": "^2.5.1",
    "@types/chai": "^4",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.5.8",
    "@types/node-notifier": "^8.0.3",
    "@types/shelljs": "^0.8.12",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "chai": "^4",
    "eslint": "^8.52.0",
    "eslint-config-oclif": "^4",
    "eslint-config-oclif-typescript": "^1.0.3",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "mocha": "^10",
    "oclif": "^3.14.0",
    "prettier": "^3.0.3",
    "shx": "^0.3.4",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "oclif": {
    "bin": "downloadify",
    "dirname": "downloadify",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "lint-staged": "lint-staged",
    "lint:fix": "next lint --fix",
    "lint:types": "tsc --pretty --noEmit --fix",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "bugs": "https://github.com/YewTreeWeb/downloadify-cli/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
